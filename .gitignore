# 项目文档（用户裁决 2026-11-05：docs/ 仅本地保留，不上传 GitHub）
docs/*

# 环境变量与密钥（.env 家族全部不入库——含 gen_env.py 的 .env.tmp 中转文件，防进程中断残留明文密钥
#   被 git add -A 误提交；仅两个模板入库。安全终审 2026-11-07 低危修复项）
.env*
!.env.example
!.env.test.example
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Node / 前端
node_modules/
dist/
coverage/

# 构建产物
build/

# 测试与覆盖率
.pytest_cache/
.coverage*
htmlcov/

# 运行期本地数据（ARCH §3.1：data/ 运行期本地数据；logs/ 错误日志轮转目录）
data/
logs/
# LangGraph Studio（make studio）本地运行产物
.langgraph_api/

# ZCode 工作区（忽略所有层级的 .zcode；例外：根 .zcode/plans/ 计划文档入库）
**/.zcode/*
!.zcode/plans/

# Mimosa 安全扫描产物
.mimosa/

# 临时产物
tmp/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
