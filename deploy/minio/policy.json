{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AiSearchServiceAccountThreeBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::ai-search-snapshots",
        "arn:aws:s3:::ai-search-snapshots/*",
        "arn:aws:s3:::ai-search-kb",
        "arn:aws:s3:::ai-search-kb/*",
        "arn:aws:s3:::langfuse",
        "arn:aws:s3:::langfuse/*"
      ]
    }
  ]
}
