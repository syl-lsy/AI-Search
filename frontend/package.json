{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ai-search 前端应用（pnpm workspace 成员；命令统一从仓库根 Makefile 跑）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage test/unit test/integration test/component",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:component": "vitest run test/component",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "pinia": "4.0.3",
    "vue": "3.5.44",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.4",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.2",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
