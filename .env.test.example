# ============================================================================
# AI Search 测试环境变量模板（基座 python-backend-base env.test.example 为底 + 本项目变量名）
# 用法：cp .env.test.example .env.test 后填凭证；.env.test 不入版本库（ARCHITECTURE §3.1/§7）。
# integration/e2e 测试读取（凭证读仓库根 .env.test）；缺凭证的用例按需 skip（§3.1 test 分层）。
# ============================================================================

# 通用（本项目无 WEB_/ENVIRONMENT——配置组划分见 ARCHITECTURE §7）
# APP_ENV 取值与 core/config.py 对齐：Literal["dev", "production"]（test 值会炸 settings 校验）
APP_ENV=dev

# 测试库（DB_；独立于开发库 ai_search）
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=ai_search_test_db
DB_USER=ai_search
DB_PASSWORD=<secret>

# 日志（LOG_）：测试进程与 e2e 子进程共用；LOG_FILE_DIR 指向 tmp/logs，
# 避免测试期故意触发的异常把错误日志写进仓库根（tmp/ 已 gitignore）
LOG_LEVEL=INFO
LOG_SLOW_QUERY_THRESHOLD=200
LOG_FILE_DIR=tmp/logs

# ── integration 真实依赖凭证（占位；缺凭证的用例按需 skip）──
# LiteLLM 网关
LITELLM_BASE_URL=http://127.0.0.1:4100
LITELLM_API_KEY=<secret>
# Nacos（NACOS_；integration config_center 用例读——运行态专用只读账号，双账号口径见
# nacos-config.md §8；变更推送换版用例的管理员凭据走 NACOS_INIT_USER/NACOS_INIT_PASS
# 临时环境变量，不入本文件）
NACOS_SERVER_ADDR=127.0.0.1:8849
NACOS_NAMESPACE=ai-search-dev
NACOS_GROUP=ai-search
NACOS_USERNAME=<secret>
NACOS_PASSWORD=<secret>
# Tavily（主位搜索源）
MCP_TAVILY_URL=https://mcp.tavily.com/mcp
TAVILY_API_KEY=tvly-<secret>
# BoCha（中文搜索源）
BOCHA_API_BASE=https://api.bochaai.com/v1
BOCHA_API_KEY=<secret>
# SearXNG（搜索兜底链首，批次 4）：暂不入本模板——接线缺口已于批次 5（2026-11-11）修复
# （core/config.py McpCredentialSettings 已声明 SEARXNG_URL/SEARXNG_MCP_COMMAND/SEARXNG_MCP_ARGS，
# 标准 .env + make dev 形态可装载），但 integration conftest 仍只强注入 DB_ 组
# （防密钥泄进收集期 os.environ），本模板的 SEARXNG_* 不会被测试进程读到——故不列；
# test_search_sources 的 searxng 真调用用例维持按设计 skip，装载方式另定后再同步
# Langfuse（LANGFUSE_；integration trace_cleanup 用例读——公共 REST 凭证即
# dev 栈同款项目 key，host 默认本地 compose 栈；trace_retention_days 缺省 7，
# 与 core/config.py LangfuseSettings 对齐，测试用例按「保留天数+1h」回填过期时间戳）
LANGFUSE_HOST=http://127.0.0.1:3100
LANGFUSE_PUBLIC_KEY=pk-lf-<secret>
LANGFUSE_SECRET_KEY=sk-lf-<secret>
LANGFUSE_TRACE_RETENTION_DAYS=7
