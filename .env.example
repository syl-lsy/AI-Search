# ============================================================================
# AI Search 环境变量模板
# 唯一对照基准：docs/ARCHITECTURE.md §7 变量清单（ARCH v1.42 现行）——
#   本文件与该清单一一对应、同步维护；改变量先改 ARCHITECTURE §7 再同步此处。
# 用法：cp .env.example .env 后填密钥；.env 不入版本库；密钥绝不入 Nacos。
# 唯一读取处：apps/search-api/app/core/config.py（BaseSettingsWithEnv 按前缀分组，
#   组划分与本清单一一对应：无前缀=通用组，DB_/MINIO_/NACOS_/LITELLM_/MCP_/LANGFUSE_/
#   SANDBOX_/SSE_/KB_/LOG_ 各一组；db_settings 等单例全局读取）。
# compose 消费型变量（注入对应容器、后端 core/config.py 均不读取）：OLLAMA_API_BASE、
#   NACOS_AUTH_* 四变量（注入 nacos 容器开启鉴权）、LITELLM_MASTER_KEY + LiteLLM DB 模式四变量
#   LITELLM_SALT_KEY/LITELLM_UI_USERNAME/LITELLM_UI_PASSWORD/LITELLM_DB_PASSWORD（注入 litellm
#   容器，v1.22 增，ADR-014）、Langfuse S3_* 组（注入 langfuse-web/worker）、SEARXNG_SECRET（注入 searxng 容器覆写 Flask secret_key）——v1.13 归并口径（ARCH §7；SEARXNG_SECRET v1.38 补录）。
# 批次 1 S0 增（deploy/docker-compose.yml 实装同步）：Langfuse 容器侧五件套（LANGFUSE_SALT/
#   LANGFUSE_ENCRYPTION_KEY/LANGFUSE_NEXTAUTH_SECRET/CLICKHOUSE_PASSWORD/LANGFUSE_DB_PASSWORD）、
#   MinIO root 凭据（MINIO_ROOT_USER/MINIO_ROOT_PASSWORD）、OPEN_SANDBOX_API_KEY、LangSmith 组
#   （LANGSMITH_API_KEY/LANGSMITH_TRACING，本机进程消费）——变量名与 Langfuse v4 实际所需逐字对齐，
#   对照 ai-agent-infra-base 技能 assets 与 Langfuse 官方 docker-compose（v4）核过；ARCH §7 v1.42 已补录
#   （LANGSMITH_ 组宿主进程/langgraph CLI 消费，core/config.py 不读取）。
# 2026-11-07 Halo 增补（v1.27，用户裁决）：LANGFUSE_AI_API_KEY（注入 langfuse-web/worker）+ compose 侧
#   Halo 常量组（详见下方 LANGFUSE_ 组「Halo」块）——Langfuse 内置对话式 AI 助手，问 AI 筛 trace。
# 占位值口径：<GEN> = 容器侧生成型密钥占位，跑 `python3 scripts/infra_smoke/gen_env.py` 自动回填随机值；
#   <secret> 等其余占位 = 人工填写（上游厂商 Key、Nacos 账号、Langfuse 项目 key 等，脚本不代填）。
# ============================================================================

# ── 应用（通用组，无前缀）──
APP_ENV=dev                          # dev | production（production 隐藏 docs/redoc/openapi）
API_HOST=127.0.0.1
API_PORT=8300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001   # MVP 固定默认用户（启动幂等 seed）
DEFAULT_USER_NAME=Local

# ── 日志（LOG_）──
LOG_LEVEL=INFO
LOG_FILE_DIR=./logs                  # dev 错误日志轮转目录（默认 logs/）
LOG_SLOW_QUERY_THRESHOLD=200         # ms；db/session.py 事件钩子慢查询阈值

# ── PostgreSQL + pgvector（DB_）──
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=ai_search
DB_PASSWORD=<GEN>
DB_NAME=ai_search
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── MinIO（MINIO_）──
MINIO_ENDPOINT=127.0.0.1:9100
# ↓ root 凭据（批次 1 S0 增，compose 消费——注入 minio 容器作 MINIO_ROOT_*，应用不读取；仅 mc 管理用）
MINIO_ROOT_USER=<GEN>
MINIO_ROOT_PASSWORD=<GEN>
# ↓ Service Account 子账号凭据（DEV §3.2 ④：应用不使用 root 凭据；policy 收窄到三桶，
#   policy 定义 = deploy/minio/policy.json）。Langfuse 的 S3_ACCESS_KEY/S3_SECRET_KEY 同值复用本对
#   （compose 内映射 LANGFUSE_S3_*_ACCESS_KEY_ID/SECRET_ACCESS_KEY，不单列变量——同值不双写）
MINIO_ACCESS_KEY=<GEN>
MINIO_SECRET_KEY=<GEN>
MINIO_SECURE=false
MINIO_BUCKET_SNAPSHOT=ai-search-snapshots
MINIO_BUCKET_KB=ai-search-kb

# ── Nacos（NACOS_；仅非敏感资产，见 docs/contract/nacos-config.md）──
# v1.13：运行态客户端一律用专用只读账号（读+监听、无写权限，双账号口径 nacos-config.md §8）；
#   前提：鉴权未开启则只读授权无意义——匿名即可读写任何配置；
#   实现口径：NacosSettings 不声明 NACOS_AUTH_* 四字段（pydantic-settings 默认忽略未声明 env），
#   勿按前缀全量声明进该组
NACOS_SERVER_ADDR=127.0.0.1:8849    # SDK 填 host:port 形式（不带 http:// 前缀与尾斜杠；v1.13 注）
NACOS_NAMESPACE=ai-search-dev
NACOS_GROUP=ai-search
NACOS_USERNAME=<专用只读账号>        # 必填（v1.13：专用只读账号，如 ai-search-ro；运行态客户端
                                    #   唯一凭据，读+监听、无写权限——原「可选」口径废止）
NACOS_PASSWORD=<GEN>                # 必填（与 NACOS_USERNAME 成对，同上口径；<GEN> 由 gen_env 生成——
                                    #   §3.2 ① 建只读账号时须以该值建账号，两侧一致）
NACOS_STARTUP_TIMEOUT_S=5
NACOS_SNAPSHOT_DIR=./data/nacos_snapshot
# ↓ nacos 容器鉴权参数（v1.13 增；compose 消费——注入 nacos 容器开启鉴权用，应用 core/config.py 不读取）
NACOS_AUTH_ENABLE=true              # 鉴权开关；未开启则匿名可读写，只读授权无意义（见组头注）
NACOS_AUTH_TOKEN=<GEN>              # base64，解码后 ≥32 字节（JWT 签名密钥硬校验；gen_env 生成 32 字节
                                    #   的 base64——短值致 nacos 启动崩溃，2026-11-06 起栈实证）
NACOS_AUTH_IDENTITY_KEY=nacos-identity  # 服务端间身份识别键（固定常量，gen_env 兜底同值）
NACOS_AUTH_IDENTITY_VALUE=<GEN>     # 与上键成对

# ── LiteLLM 网关（LITELLM_；chat（Standard/Speed 两档）/vision/embedding/rerank 全走这里）──
LITELLM_BASE_URL=http://127.0.0.1:4100
LITELLM_API_KEY=<GEN>               # 与 LITELLM_MASTER_KEY 同值（gen_env 镜像回填）——应用调网关凭证
LITELLM_MASTER_KEY=<GEN>            # compose 消费（注入 litellm 容器），应用不读取；与 LITELLM_API_KEY
                                    #   同值——应用调网关凭证=网关 Master Key（静态 config 模式）；
                                    #   UI :4100/ui 登录用（v1.13 审查修正增；v1.22 起 UI 日常登录改
                                    #   UI_USERNAME/UI_PASSWORD，Master Key 仍可登录——ADR-014）
# ↓ LiteLLM DB 模式（v1.22 增，ADR-014；镜像 litellm/litellm-database:v1.101.0——compose 消费，注入
#   litellm 容器，应用 core/config.py 不读取；教学口令勿照抄，一律 .env）：
LITELLM_SALT_KEY=<GEN>              # 虚拟 key 加密盐（DB 模式必填）
LITELLM_UI_USERNAME=ai-search-admin  # 控制台登录账号（固定常量，gen_env 兜底同值；与 UI_PASSWORD 成对）
LITELLM_UI_PASSWORD=<GEN>           # 控制台登录密码
LITELLM_DB_PASSWORD=<GEN>           # postgres 第三库 litellm 的密码（compose 拼 DATABASE_URL 引用）
#   （DATABASE_URL / STORE_MODEL_IN_DB="True" / STORE_PROMPTS_IN_SPEND_LOGS="True" /
#    REDIS_HOST/REDIS_PORT/REDIS_DB=1 为 compose 内拼装值，非敏感不进 .env——§5 litellm/redis 行）
# 上游 key 与 base URL（被 deploy/litellm/config.yaml 以 ${ENV} 引用，进 litellm 容器；MCP_ 组见下）
# v1.11 核查：三供应商 × 两档（chat-standard* / chat-speed*）所需变量齐备，无新增项；
# v1.23 增量（2026-11-05 用户凭证形态裁决）：百炼走 Token Plan、智谱走 Coding Plan——两家订阅套餐均为
#   「专属端点 + 专属 Key」，与按量端点/按量 Key 成对区分（端点混用 404 / 不抵扣套餐）；
#   embedding/rerank 不在 Token Plan 抵扣范围（官方文档定案）——必走百炼通用端点 + 标准 Key；
#   两家套餐的并发/限流边界 S0 同批实测（R11 核验点，不通过走按量回退）
ZHIPU_CODING_PLAN_API_KEY=<secret>     # 智谱 Coding Plan 专属 Key（个人编程套餐页生成）——chat 档 GLM 走
                                       #   ZHIPU_CODING_PLAN_BASE_URL 抵扣套餐
ZHIPU_CODING_PLAN_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
                                       # 智谱 Coding Plan 专属 OpenAI 兼容端点（官方文档口径；与按量端点差 /coding 段）
ZHIPU_API_KEY=<secret>                 # 智谱按量标准 Key（sk-）：GLM-5.3 / GLM-5.3-flash（+ vision glm-4.5v 候选）——
                                       #   配 ZHIPU_BASE_URL；R11 回退路径（Coding Plan 限流不足时切换），可后办
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
                                       # 智谱按量 OpenAI 兼容端点（官方文档口径）
DEEPSEEK_API_KEY=<secret>              # DeepSeek 开放平台申请：deepseek-v4-pro / deepseek-flash
                                       #   （flash 档位名以控制台逐字核对为准）
DASHSCOPE_TOKEN_PLAN_API_KEY=<secret>  # 百炼 Token Plan 专属 Key（sk-sp- 前缀，「我的订阅」页生成、仅完整显示一次）——
                                       #   **与 DASHSCOPE_API_KEY 不是同一把 Key，不可混用**；chat 档 qwen 走
                                       #   DASHSCOPE_TOKEN_PLAN_BASE_URL 抵扣套餐（套餐仅覆盖 qwen3.7-plus 及
                                       #   千问系列部分模型，无向量模型，范围以套餐控制台为准）
DASHSCOPE_TOKEN_PLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
                                      # 百炼 Token Plan 专属 OpenAI 兼容端点（官方快速开始文档口径；区域以控制台为准）
DASHSCOPE_API_KEY=<secret>             # 百炼通用标准按量 Key（sk-，**与 Token Plan 专属 Key 不是同一把**）：
                                       #   embedding(text-embedding-v4)/rerank(qwen3-rerank) 必走 DASHSCOPE_BASE_URL
                                       #   （Token Plan 不含向量/排序模型，官方文档定案）+ chat 按量回退；
                                       #   S0 五类 smoke 前必办（embedding/rerank 调用量小、按量费用极低）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
                                       # 百炼通用 OpenAI 兼容端点（官方文档口径）
OLLAMA_API_BASE=http://host.docker.internal:11434   # 本地 Ollama 上游地址；v1.19 起 light 默认回本地 qwen3.5:4b
                                                   #   （S14/ADR-008 v1.19 增注），宿主 Ollama 重回默认运行时依赖；
                                                   #   litellm fallback 链以 chat-speed 云端兜底（§6.7）

# ── 搜索/读取 MCP（MCP_；清单在 Nacos，凭证在此；v1.12 起五源、v1.32 起六源：主位三源 + 搜索备位链 searxng/anysearch + 读取备位 crawl4ai）──
MCP_TAVILY_URL=https://mcp.tavily.com/mcp
TAVILY_API_KEY=tvly-<secret>
BOCHA_API_BASE=https://api.bochaai.com/v1
BOCHA_API_KEY=<secret>
BOCHA_MCP_TRANSPORT=stdio             # 官方远程 MCP 可用后改 http
BOCHA_MCP_COMMAND=uvx                 # stdio 官方形态以 R1 锚定为准（v1.19：github.com/BoChaAI/
                                      #   bocha-search-mcp，uv run bocha-search-mcp；示例值 S0 实测收敛）
BOCHA_MCP_ARGS=bocha-search-mcp       # R1 实测收敛（2026-11-06）：仓库实际入口=bocha-search-mcp
                                      #   （旧示例值 bochaai-mcp-server 有误）；实装工具名为 snake_case
                                      #   （bocha_web_search / bocha_ai_search），S1 装载按此
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/mcp
FIRECRAWL_API_KEY=fc-<secret>
MCP_ANYSEARCH_URL=https://api.anysearch.com/mcp    # 搜索兜底链次级（fallback_search_secondary，v1.32；v1.12 原三级兜底独担）
ANYSEARCH_API_KEY=as_sk-<secret>
MCP_CRAWL4AI_URL=http://127.0.0.1:11235/mcp/sse    # 自部署备胎（url_reader_backup 备位）；上游支持 streamable http 后可切
CRAWL4AI_API_TOKEN=<GEN>                           # 与 crawl4ai 容器同变量注入（gen_env token_hex(24)=48 hex 字符/192bit）
SEARXNG_URL=http://127.0.0.1:18080                 # 自部署 SearXNG（搜索兜底链首 fallback_search，v1.32；后端 McpCredentialSettings
#   读取后经 stdio spawn 注入 wrapper 子进程环境，mcp.json 不承载——v1.38 接线修复（此前 .env 值不生效、
#   wrapper 装不上，降级链退化 AnySearch 独担）；三件套空值=未配置态，本身即备位源 readiness 门）
SEARXNG_SECRET=<GEN>                # searxng 容器 Flask 会话签名 secret（compose 消费——注入容器 env
#   SEARXNG_SECRET 覆写 settings secret_key；镜像对默认值 ultrasecretkey
#   硬拒绝启动，2026-11-09 实证；应用 core/config.py 不读取）
SEARXNG_MCP_COMMAND=uv                             # 自研薄 stdio MCP wrapper 入口（B3 实装收敛，同 BOCHA_MCP_COMMAND 模式）
SEARXNG_MCP_ARGS=run --package search-api python -m app.agent.tools.searxng_mcp
# wrapper 启动参数（B3 实装收敛 2026-11-09；须自仓库根 cwd spawn——后端
#   make dev 即仓库根、子进程继承；备选形态=http wrapper 容器
#   （transport 切 http + url_env，零改码））

# ── Langfuse（LANGFUSE_）──
LANGFUSE_HOST=http://127.0.0.1:3100
LANGFUSE_PUBLIC_KEY=pk-lf-<secret>
LANGFUSE_SECRET_KEY=sk-lf-<secret>
# ↓ 网关侧观测 → Langfuse OTLP（批次 1 实装；compose 注入 litellm 容器，config.yaml success_callback:["otel"] 消费；
#   v4 旧式 langfuse callback 被 ingestion schema 拒绝已实证。值=pk/sk 建项目后回填：
OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-web:3030/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(pk:sk)>   # 「pk:sk」拼串再 base64
LANGFUSE_TRACE_RETENTION_DAYS=7       # trace 保留天数参数（v1.19 语义改写：本服务 crons/trace_cleanup.py 按
                                      #   此天数查过期 trace 并分批调公共 API 删除——非 Langfuse 原生能力，
                                      #   OSS 内置保留治理 = EE 付费不可用，官方文档定案；读本服务环境，
                                      #   不再注入 langfuse 容器，§5 注）。
                                      #   M1 部署后实测 API 批删生效（ClickHouse/MinIO 清理滞后一并观察）
LANGFUSE_WEBHOOK_ALERT_SECRET=<secret>       # Langfuse→本服务告警 webhook（POST /api/webhooks/langfuse/alerts）
                                             #   签名密钥（v1.18 A 项；M4 落地）——应用读取（LangfuseSettings 组，
                                             #   非 compose 消费型）；每用途一把独立密钥；空值=拒绝校验而非放行
LANGFUSE_WEBHOOK_EXPERIMENT_SECRET=<secret>  # 评测实验回调（POST /api/webhooks/langfuse/experiments）签名密钥
                                             #   （同上口径，独立于告警密钥；校验实现 utils/webhook_signature.py）
# ↓ Langfuse 容器侧五件套（批次 1 S0 增；compose 消费——注入 langfuse-web/worker 与 clickhouse
#   容器，应用 core/config.py 不读取；<GEN> 由 gen_env.py 自动生成）：
LANGFUSE_SALT=<GEN>                  # trace 加盐（注入容器 env SALT）——首启后固定不变，更换致已存数据不可解
LANGFUSE_ENCRYPTION_KEY=<GEN>        # API Key 加密主密钥（注入容器 env ENCRYPTION_KEY，32 字节 hex）——同上固定不变
LANGFUSE_NEXTAUTH_SECRET=<GEN>       # web 会话签名（注入 langfuse-web env NEXTAUTH_SECRET）
CLICKHOUSE_PASSWORD=<GEN>            # clickhouse root 密码（clickhouse + langfuse-web/worker 容器共用同值）
LANGFUSE_DB_PASSWORD=<GEN>           # postgres 第二库 langfuse 密码（postgres init.sh 建角色 + compose 拼 DATABASE_URL）
# ↓ Langfuse S3 对象存储实名组（批次 1 S0 增；v1.13 审查修正口径细化）——变量名 = Langfuse v4 官方实名
#   （对照 ai-agent-infra-base 技能 assets 与 Langfuse v4 docker-compose 核过）。**不单列 .env 变量**：
#   端点/桶/区域为 compose 内拼装常量（同 LITELLM DATABASE_URL 口径——非敏感不进 .env）；凭据同值不双写：
#   S3 密钥复用本文件 MINIO_ACCESS_KEY/MINIO_SECRET_KEY（Service Account 对，policy 收窄含 langfuse 桶），
#   compose 直接映射——不另设 <GEN>，避免 gen_env 生成两把不一致密钥致 trace 上传静默 403。
#   与 ARCH §7 概念名 S3_* 的映射（§7 S3_* 组巡检同步待办；deploy/docker-compose.yml 落地实名注入）：
#     S3_ENDPOINT   → LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT / LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT（+_INTERNAL_ENDPOINT）
#                     / LANGFUSE_S3_BATCH_EXPORT_ENDPOINT（+_EXTERNAL_ENDPOINT）——容器内 http://minio:9000；
#                     web 侧 media 对浏览器走 http://127.0.0.1:9100（双地址模式）
#     S3_ACCESS_KEY → LANGFUSE_S3_*_ACCESS_KEY_ID = ${MINIO_ACCESS_KEY}（三通道同值）
#     S3_SECRET_KEY → LANGFUSE_S3_*_SECRET_ACCESS_KEY = ${MINIO_SECRET_KEY}（三通道同值）
#     S3_BUCKET     → LANGFUSE_S3_*_BUCKET = langfuse（三通道同值；必须与 ARCH §5 minio 行第三桶同名——
#                     错配时 trace 上传静默 403，DEV §3.2 ④ 同警示）
#     S3_REGION     → LANGFUSE_S3_*_REGION = auto；各通道 _FORCE_PATH_STYLE = true（MinIO 无虚拟主机寻址）
#   （实名前缀三通道：_EVENT_UPLOAD_ / _MEDIA_UPLOAD_ / _BATCH_EXPORT_，全量清单见 deploy/docker-compose.yml）
# ↓ Langfuse Halo（v1.27 增，2026-11-07 用户裁决；compose 消费——注入 langfuse-web/worker，应用
#   core/config.py 不读取）。Langfuse 内置对话式 AI 助手「问 AI 筛 trace」（agentic：MCP 项目工具 +
#   文档检索，感知当前页面上下文，改数据前请求确认）；官方要求 ≥ v4.28（现行 4.56 满足）；
#   配置不全 = UI 显示未启用、不影响起栈——故 API key 可空、非 fail-fast：
LANGFUSE_AI_API_KEY=<secret>         # Halo 调用模型的凭证 = LiteLLM 虚拟 key（别名 langfuse-halo，模型白名单
#   [chat-speed, qwen3.5-4b-ollama]；勿复用 Master Key / LITELLM_API_KEY——
#   独立 key 便于 spend 归因与吊销；改 compose 侧模型须同步此白名单）
#   （compose 内拼装常量，非敏感不进 .env——同 DATABASE_URL 口径；详见 deploy/docker-compose.yml
#    x-langfuse-common-env 块与 worker/web 专属注：LANGFUSE_IN_APP_AGENT_ENABLED=true /
#    LANGFUSE_AI_PROVIDER=openai / LANGFUSE_AI_MODEL=chat-speed（主力问询，Token Plan 抵扣）/
#    LANGFUSE_AI_SMALL_MODEL=qwen3.5-4b-ollama（会话标题等杂活走本地，零边际成本）/
#    LANGFUSE_AI_BASE_URL=http://litellm:4000/v1（容器网内直连——litellm 容器内端口 4000，宿主 4100
#    仅供宿主进程；Halo 自有 provider client，不受
#    LLM Connections 的 SSRF 白名单变量约束）/ worker 专属 LANGFUSE_MCP_BASE_URL=http://langfuse-web:3030
#    与 web 专属 LANGFUSE_MCP_ALLOWED_HOSTS=langfuse-web（Halo MCP 工具链路官方前置）。
#    模型须支持 OpenAI 风格 tool calling；沙箱代码执行工具仅 AWS Lambda MicroVM、自托管不可用——
#    核心 trace 问答不受影响。成本观测口径零变更：litellm model_info 全模型单价已配（Langfuse 直接
#    采集 LiteLLM cost），Halo 只是网关新增消费方，其调用本身留痕于 Langfuse trace）

# ── LangSmith（本机进程消费；可选——LangGraph Studio 用（`make studio`），官方前置=免费账号+API Key 仅作
#    UI 认证；观测主通道 = 自托管 Langfuse，trace 数据不出本机（LANGSMITH_TRACING 固定 false，
#    `make studio` 显式导出兜底——ARCH §6.6 Studio 边界条））──
LANGSMITH_API_KEY=                   # 可选——LangGraph Studio（make studio）UI 认证用；上游厂商 Key 同口径留空——gen_env 不代填，用户自填
LANGSMITH_TRACING=false              # 固定 false（防 LangChain 默认行为把 trace 上报 LangSmith 云；观测走自托管 Langfuse）

# ── OpenSandbox（SANDBOX_，M4；v1.5 收敛：仅连接类变量——运行参数归 Agent Spec
#    deep.code_exec_timeout_s / code_exec_cpu_limit / code_exec_mem_limit_mb 热调，nacos-config.md §3）──
SANDBOX_ENABLED=false
SANDBOX_API_BASE_URL=http://127.0.0.1:8801
SANDBOX_ARTIFACTS_DIR=./data/sandbox
# ↓ opensandbox server 容器鉴权密钥（批次 1 S0 增；compose 消费——注入 opensandbox 容器 env
#   OPENSANDBOX_SERVER_API_KEY，应用 core/config.py 不读取；compose 端 ${VAR:?} 缺失即起栈失败——
#   无鉴权沙箱 API 等于半个 root 入口，不设可空占位）
OPEN_SANDBOX_API_KEY=<GEN>

# ── SSE / 流式（SSE_）──
SSE_EVENT_TTL_MINUTES=30              # 终态后静止 TTL（v1.7 语义精确化：滑动续期——每事件写入刷新，
                                      #   运行中轮永不过期，仅终态后 30min 无写入且无活跃订阅才回收；
                                      #   ADR-003 v1.7 增注 / api.md §7.3 v1.5 注）
SSE_HEARTBEAT_SECONDS=15
SSE_BUFFER_MAX_EVENTS=20000

# ── 知识库（KB_）──
KB_MAX_FILE_MB=20
KB_ALLOWED_TYPES=pdf,md,txt,docx
KB_EMBEDDING_DIM=1024                 # schema 常量，变更需迁移
KB_CHUNK_SIZE=800                     # 字符
KB_CHUNK_OVERLAP=120
KB_TOP_K_PER_QUERY=8

# ── 前端（VITE_；批次 7 F1 增）──
# 仅 frontend/ 消费：Vite 从 frontend/.env 读取（frontend/.env.example 为其模板），
# 本段为全仓变量清单对照——仓库根 .env 不被 Vite 读取（后端 BaseSettingsWithEnv 忽略未声明变量）。
# 唯一读取处：frontend/src/api/client.ts（frontend-api.md §8.4 请求唯一出口）；
#   未设/空串 = 同源相对路径，REST/SSE 走 vite dev proxy `/api → http://127.0.0.1:8300`；
#   直连形态 = 填后端 origin（CORS_ORIGINS 已放行 :5173 两个 origin，改端口须同步白名单）。
VITE_API_BASE_URL=http://127.0.0.1:8300
